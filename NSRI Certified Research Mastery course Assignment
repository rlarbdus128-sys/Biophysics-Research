def all_paths(root):
    root = Path(root)
    return [p for p in root.rglob("*") if p.is_file()]


def norm_name(p):
    return p.name.lower()


def has_any(s, keys):
    s = str(s).lower()
    return any(k in s for k in keys)


def file_size(p):
    try:
        return Path(p).stat().st_size
    except Exception:
        return -1


def choose_file(paths, include_keys, exclude_keys=(), suffixes=()):
    candidates = []

    for p in paths:
        n = norm_name(p)

        if include_keys and not has_any(n, include_keys):
            continue

        if exclude_keys and has_any(n, exclude_keys):
            continue

        if suffixes and not any(n.endswith(sfx) for sfx in suffixes):
            continue

        candidates.append(p)

    if not candidates:
        return None

    candidates = sorted(candidates, key=lambda x: file_size(x), reverse=True)
    return candidates[0]


def read_table_auto(path, header="infer", nrows=None):
    path = Path(path)
    name = path.name.lower()

    if name.endswith((".csv", ".csv.gz")):
        return pd.read_csv(path, header=header, nrows=nrows)

    if name.endswith((".tsv", ".tsv.gz", ".txt", ".txt.gz")):
        return pd.read_csv(path, sep="\t", header=header, nrows=nrows)

    return pd.read_csv(path, sep=None, engine="python", header=header, nrows=nrows)


def read_vector_file(path):
    df0 = read_table_auto(path, header=None)
    if df0.shape[1] == 0:
        raise ValueError(f"empty file: {path}")
    return df0


def safe_series_to_csv(series, path):
