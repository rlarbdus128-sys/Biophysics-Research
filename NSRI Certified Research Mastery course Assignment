R = R_hvg.tocsr()
absR = abs(R)

l2_norm = np.sqrt(np.asarray(R.multiply(R).sum(axis=1)).ravel())
mean_abs = np.asarray(absR.mean(axis=1)).ravel()

try:
    max_abs = np.asarray(absR.max(axis=1).toarray()).ravel()
except Exception:
    max_abs = np.array(
        [absR.getrow(i).max() for i in range(absR.shape[0])],
        dtype=float
    )

