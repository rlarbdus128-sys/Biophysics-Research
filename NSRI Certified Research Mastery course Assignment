def rowwise_metrics(Y_true, Y_pred, names=None):

    rows = []

    for i in range(Y_true.shape[0]):

        yt = np.asarray(Y_true[i]).ravel()
        yp = np.asarray(Y_pred[i]).ravel()

        residual = yt - yp

        if np.std(yt) == 0 or np.std(yp) == 0:
            pearson = np.nan
            spearman = np.nan
        else:
            pearson = pearsonr(yt, yp)[0]
            spearman = spearmanr(yt, yp).correlation

        rmse = np.sqrt(np.mean(residual ** 2))

        denom = (
            np.linalg.norm(yt)
            * np.linalg.norm(yp)
        )

        cosine = (
            np.dot(yt, yp) / denom
            if denom > 0 else np.nan
        )

        row = {
            "pearson": pearson,
            "spearman": spearman,
            "rmse": rmse,
            "cosine_similarity": cosine,
            "observed_l2_norm": np.linalg.norm(yt),
            "predicted_l2_norm": np.linalg.norm(yp),
            "residual_l2_norm": np.linalg.norm(residual)
        }

        if names is not None:
            row["name"] = names[i]

        rows.append(row)

    return pd.DataFrame(rows)
