    "derived_downstream_outputs/weak_response_perturbations.csv",
    "derived_downstream_outputs/response_gene_effect_count_summary_hvg.csv",
    "derived_downstream_outputs/double_perturbation_pairs_detected.csv",
    "derived_downstream_outputs/double_additive_residual_metrics_hvg.csv",
    "derived_downstream_outputs/hypothesis_conclusion_table_template.csv",

    # json
    "derived_downstream_outputs/response_strength_thresholds.json",

    # png
    "fig_reconstruction_vs_components.png",
    "fig_geometry_vs_components.png",
]

results = []

for rel_path in files_to_validate:

    path = OUT / rel_path

    row = {
        "file": rel_path,
        "exists": path.exists(),
        "valid": False,
        "detail": "",
    }

    if not path.exists():
        row["detail"] = "missing"
        results.append(row)
        continue

    suffix = path.suffix.lower()

    try:

        # =========================
        # CSV
        # =========================
        if suffix == ".csv":

            df = pd.read_csv(path)

            row["valid"] = True
            row["detail"] = f"csv shape={df.shape}"

        # =========================
        # NPZ sparse matrix
        # =========================
        elif suffix == ".npz":

            mat = sparse.load_npz(path)

            row["valid"] = True
            row["detail"] = f"sparse shape={mat.shape}"

        # =========================
        # NPY array
        # =========================
        elif suffix == ".npy":

            arr = np.load(path)

            row["valid"] = True
            row["detail"] = f"array shape={arr.shape}"

        # =========================
        # JSON
        # =========================
        elif suffix == ".json":

            with open(path, "r") as f:
                obj = json.load(f)

            row["valid"] = True
            row["detail"] = f"json keys={len(obj)}"

        # =========================
        # PNG
        # =========================
        elif suffix == ".png":

            size_kb = round(path.stat().st_size / 1024, 2)

            row["valid"] = size_kb > 0
            row["detail"] = f"png size={size_kb} KB"

        else:

            row["detail"] = "unknown file type"

    except Exception as e:

        row["valid"] = False
        row["detail"] = repr(e)

    results.append(row)

check_df = pd.DataFrame(results)

print("=" * 60)
print("FINAL FILE VALIDATION")
print("=" * 60)

print(check_df)

print("\n")

print("TOTAL FILES:", len(check_df))
print("VALID FILES:", int(check_df["valid"].sum()))
print("INVALID FILES:", int((~check_df["valid"]).sum()))

print("\n=== INVALID FILES ===")
display(check_df.loc[~check_df["valid"]])

# 저장
save_path = OUT / "final_file_validation.csv"
check_df.to_csv(save_path, index=False)

print("\nSaved:")
print(save_path)

