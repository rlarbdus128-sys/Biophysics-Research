def fit_pca(R, train_idx, test_idx, k):
    scaler = StandardScaler(with_mean=True, with_std=True)
    X_train = scaler.fit_transform(R[train_idx])
    X_test = scaler.transform(R[test_idx])

    model = PCA(n_components=k, random_state=RANDOM_STATE)
    Z_train = model.fit_transform(X_train)
    Z_test = model.transform(X_test)

    Xhat = model.inverse_transform(Z_test)
    Rhat = scaler.inverse_transform(Xhat)

    return model, Z_train, Z_test, Rhat


def fit_svd(R, train_idx, test_idx, k):
    scaler = StandardScaler(with_mean=False, with_std=True)
    X_train = scaler.fit_transform(R[train_idx])
    X_test = scaler.transform(R[test_idx])

    model = TruncatedSVD(n_components=k, random_state=RANDOM_STATE)
    Z_train = model.fit_transform(X_train)
    Z_test = model.transform(X_test)

    Xhat = model.inverse_transform(Z_test)
    Rhat = Xhat / scaler.scale_

    return model, Z_train, Z_test, Rhat


def fit_nmf(R, train_idx, test_idx, k):
    min_val = float(np.nanmin(R[train_idx]))
    shift = -min_val if min_val < 0 else 0.0

    X_train = R[train_idx] + shift
    X_test = R[test_idx] + shift

    model = NMF(
        n_components=k,
        init="nndsvda",
        random_state=RANDOM_STATE,
        max_iter=1000
    )

    Z_train = model.fit_transform(np.maximum(X_train, 0))
    Z_test = model.transform(np.maximum(X_test, 0))

    Xhat = model.inverse_transform(Z_test)
    Rhat = Xhat - shift

    return model, Z_train, Z_test, Rhat
