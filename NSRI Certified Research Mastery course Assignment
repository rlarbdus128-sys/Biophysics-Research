R_hvg = sparse.load_npz(R_hvg_path).tocsr()

if hvg_gene_path.exists():
    hvg_genes = load_first_column_csv(hvg_gene_path)
else:
    hvg_genes = np.array([f"hvg_{i}" for i in range(R_hvg.shape[1])])

print("Metadata shape:", meta.shape)
print("R_hvg shape:", R_hvg.shape)


# ------------------------------------------------------------
# 3. Response strength metrics
# ------------------------------------------------------------

print("\nGenerating response strength metrics...")

abs_R = abs(R_hvg)

response_strength = meta.copy()

response_strength["response_l2_norm_hvg"] = np.sqrt(
    R_hvg.power(2).sum(axis=1)
).A1

response_strength["response_l1_norm_hvg"] = abs_R.sum(axis=1).A1

response_strength["mean_abs_response_hvg"] = (
    abs_R.sum(axis=1).A1 / R_hvg.shape[1]
)

response_strength["max_abs_response_hvg"] = (
    abs_R.max(axis=1).toarray().ravel()
)

for threshold in (0.01, 0.05, 0.10, 0.20):
    col = f"n_hvg_abs_response_gt_{str(threshold).replace('.', 'p')}"
    response_strength[col] = (abs_R > threshold).sum(axis=1).A1

response_strength.to_csv(
    DERIVED / "perturbation_response_strength_metrics.csv",
    index=False
)

print("Saved response strength metrics")


# ------------------------------------------------------------
# 4. Response strength distribution plot
# ------------------------------------------------------------

plt.figure(figsize=(8, 5))

plt.hist(
    response_strength["response_l2_norm_hvg"],
    bins=50
)

plt.xlabel("HVG response L2 norm")
plt.ylabel("Number of perturbations")
plt.title("Perturbation response strength distribution")

plt.tight_layout()

plt.savefig(
    DERIVED / "fig_response_strength_distribution.png",
    dpi=200
)

plt.close()

print("Saved response strength figure")


# ------------------------------------------------------------
# 5. Latent coordinates with TruncatedSVD
# ------------------------------------------------------------

print("\nGenerating latent coordinates...")

n_perturbations, n_genes = R_hvg.shape

candidate_k = [2, 3, 5, 10, 20]

candidate_k = [
    k for k in candidate_k
    if k < min(n_perturbations, n_genes)
]

latent_geometry_rows = []

R_dense = R_hvg.toarray()

original_dist = pdist(R_dense, metric="euclidean")

for k in candidate_k:

    print("Running SVD with k =", k)

    svd = TruncatedSVD(
        n_components=k,
        random_state=0
    )

    Z = svd.fit_transform(R_hvg)

    coord_df = meta.copy()

    for j in range(k):
        coord_df[f"latent_{j+1}"] = Z[:, j]

    coord_path = DERIVED / f"latent_coordinates_svd_k{k}.csv"

    coord_df.to_csv(coord_path, index=False)

    loading_df = pd.DataFrame({
        "gene": hvg_genes
    })

    for j in range(k):
        loading_df[f"component_{j+1}"] = svd.components_[j]

    loading_path = DERIVED / f"latent_gene_loadings_svd_k{k}.csv"

    loading_df.to_csv(loading_path, index=False)

    latent_dist = pdist(Z, metric="euclidean")

    latent_geometry_rows.append({
        "model": "TruncatedSVD",
        "n_components": k,
        "explained_variance_ratio_sum":
            float(np.sum(svd.explained_variance_ratio_)),
        "geometry_pearson":
            safe_pearson(original_dist, latent_dist),
        "geometry_spearman":
            safe_spearman(original_dist, latent_dist)
    })

latent_geometry_df = pd.DataFrame(latent_geometry_rows)

latent_geometry_df.to_csv(
    DERIVED / "latent_geometry_metrics.csv",
    index=False
)

print("Saved latent geometry metrics")


# ------------------------------------------------------------
# 6. Double perturbation additive residuals
# ------------------------------------------------------------

print("\nGenerating additive residual metrics...")

pairs_path = OUT / "double_perturbation_pairs_detected.csv"

if pairs_path.exists():

    pairs = pd.read_csv(pairs_path)

    pert_to_idx = {
        str(p): i
        for i, p in enumerate(
            meta["perturbation"].astype(str)
        )
    }

    residual_rows = []

    for row in pairs.itertuples(index=False):

        if not (
            hasattr(row, "pair")
            and hasattr(row, "gene_a")
            and hasattr(row, "gene_b")
        ):
            continue

        double_name = str(row.pair)
        a_name = str(row.gene_a)
        b_name = str(row.gene_b)

        if (
            double_name not in pert_to_idx
            or a_name not in pert_to_idx
            or b_name not in pert_to_idx
        ):
            continue

        obs = R_hvg[
            pert_to_idx[double_name]
        ].toarray().ravel()

        pred = (
            R_hvg[pert_to_idx[a_name]].toarray().ravel()
            + R_hvg[pert_to_idx[b_name]].toarray().ravel()
        )

        metrics = vector_metrics(obs, pred)

        out = {
            "double_perturbation": double_name,
            "perturbation_a": a_name,
            "perturbation_b": b_name
        }

        out.update(metrics)

        residual_rows.append(out)

    residual_df = pd.DataFrame(residual_rows)

    residual_df.to_csv(
        DERIVED / "double_additive_residual_metrics_hvg.csv",
        index=False
    )

    print("Saved additive residual metrics")


# ------------------------------------------------------------
# 7. Final inventory
# ------------------------------------------------------------

generated_files = sorted(DERIVED.glob("*"))

inventory = pd.DataFrame([
    file_status(f)
    for f in generated_files
])

inventory.to_csv(
    DERIVED / "analysis_file_inventory_generated.csv",
    index=False
)

print("\nGenerated files:")
display(inventory)

