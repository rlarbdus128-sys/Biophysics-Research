def sparse_col_var_chunks(X, chunk_size=2000):
    n_rows, n_cols = X.shape
    out = np.zeros(n_cols, dtype=np.float32)

    for start in range(0, n_cols, chunk_size):
        end = min(start + chunk_size, n_cols)

        block = X[:, start:end].toarray().astype(np.float32)
        out[start:end] = block.var(axis=0)

        del block
        gc.collect()

    return out


