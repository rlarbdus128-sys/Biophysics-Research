DERIVED = OUT / "derived_downstream_outputs"
DERIVED.mkdir(parents=True, exist_ok=True)

print("OUT:", OUT)
print("DERIVED:", DERIVED)


# ------------------------------------------------------------
# 1. Helpers
# ------------------------------------------------------------

def read_csv_if_exists(path):
    path = Path(path)
    if path.exists():
        return pd.read_csv(path)
    return None


def load_sparse_if_exists(path):
    path = Path(path)
    if path.exists():
        try:
            return load_npz(path).tocsr()
        except Exception as e:
            print(f"WARNING: failed to load sparse matrix: {path}")
            print(e)
            return None
    return None


def save_json(obj, path):
    path = Path(path)
    with open(path, "w") as f:
        json.dump(obj, f, indent=2, ensure_ascii=False)


def first_existing_column(df, candidates):
    for c in candidates:
        if c in df.columns:
            return c
    return None


def safe_numeric_series(df, col, default=np.nan):
    if col is None or col not in df.columns:
        return pd.Series(np.repeat(default, len(df)), index=df.index)
    return pd.to_numeric(df[col], errors="coerce")


def dense_row(mat, i):
    row = mat.getrow(i)
    return np.asarray(row.toarray()).ravel()


def vector_metrics(obs, pred, eps=1e-12):
    obs = np.asarray(obs).ravel()
    pred = np.asarray(pred).ravel()
    resid = obs - pred

    obs_norm = float(np.linalg.norm(obs))
    pred_norm = float(np.linalg.norm(pred))
    resid_norm = float(np.linalg.norm(resid))

    rmse = float(np.sqrt(np.mean(resid ** 2)))
    mae = float(np.mean(np.abs(resid)))

    denom = obs_norm * pred_norm

    if denom > eps:
        cosine = float(np.dot(obs, pred) / denom)
    else:
        cosine = np.nan

    if np.std(obs) > eps and np.std(pred) > eps:
        pearson = float(np.corrcoef(obs, pred)[0, 1])
    else:
        pearson = np.nan

    try:
        sp = spearmanr(obs, pred)
        spearman = float(sp.correlation)
    except Exception:
        spearman = np.nan

    if obs_norm > eps:
        relative_residual_norm = float(resid_norm / obs_norm)
    else:
        relative_residual_norm = np.nan

    return {
        "observed_l2_norm": obs_norm,
        "predicted_l2_norm": pred_norm,
        "residual_l2_norm": resid_norm,
        "relative_residual_l2_norm": relative_residual_norm,
        "rmse": rmse,
        "mae": mae,
        "cosine_similarity": cosine,
        "pearson_correlation": pearson,
        "spearman_correlation": spearman,
    }


def normalize_name(x):
    if pd.isna(x):
        return ""
    return str(x).strip()


def is_control_name(x):
    s = normalize_name(x).lower()

    control_tokens = {
        "control",
        "ctrl",
        "non-targeting",
        "nontargeting",
        "nt",
        "negctrl",
        "negative_control",
        "safe-targeting"
    }

    if s in control_tokens:
        return True

    if "control" in s:
        return True

    if "ctrl" in s:
        return True

    if "non-target" in s:
        return True

    if "nontarget" in s:
        return True

    return False


def parse_double_name(name, known_single_names=None):

    s = normalize_name(name)

    if not s:
        return None, None, "empty_name"

    known = set(known_single_names) if known_single_names is not None else set()

    for sep in ["+", "|", ",", ";"]:
        if sep in s:
            parts = [p.strip() for p in s.split(sep) if p.strip()]
            if len(parts) == 2:
                return parts[0], parts[1], "parsed"

    if "__" in s:
        parts = [p.strip() for p in s.split("__") if p.strip()]
        if len(parts) == 2:
            return parts[0], parts[1], "parsed"

    if "_" in s:
        parts = [p.strip() for p in s.split("_") if p.strip()]
        if len(parts) == 2:
            a, b = parts
            if not known or (a in known and b in known):
                return a, b, "parsed"

    return None, None, "could_not_parse"


