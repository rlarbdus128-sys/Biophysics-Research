    raise FileNotFoundError(f"Missing required file: {meta_path}")

if R_hvg is None:
    raise FileNotFoundError(
        f"""
Could not load sparse matrix:

{hvg_path}

This usually means:
1. the file does not exist
OR
2. the file is corrupted
OR
3. a dense matrix was accidentally saved with .npz

Check the file manually with:
!ls -lh /kaggle/working/norman_response_compression_outputs
"""
    )

if hvg_genes is None:
    raise FileNotFoundError(f"Missing required file: {gene_path}")

if R_hvg.shape[0] != len(meta):
    raise ValueError(
        f"Row mismatch: R_hvg has {R_hvg.shape[0]} rows, "
        f"but metadata has {len(meta)} rows."
    )

pert_col = first_existing_column(
    meta,
    [
        "perturbation",
        "perturbation_name",
        "condition",
        "gene",
        "target",
        "guide_target"
    ]
)

if pert_col is None:
