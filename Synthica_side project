def save_metadata(cfg, output_dir):

    path = (
        Path(output_dir)
        / "study_metadata.json"
    )

    with open(
        path,
        "w",
        encoding="utf-8"
    ) as handle:

        json.dump(
            cfg,
            handle,
            indent=2
        )


def save_reproducibility_log(
    cfg,
    output_dir
):

    path = (
        Path(output_dir)
        / "reproducibility_log.txt"
    )

    with open(
        path,
        "w",
        encoding="utf-8"
    ) as handle:

        handle.write(
            "Project: "
            + str(cfg["project"]["name"])
            + os.linesep
        )

        handle.write(
            "Random seed: "
            + str(
                cfg["project"]["random_seed"]
            )
            + os.linesep
        )

        handle.write(
            "Model: transverse-field Ising chain"
            + os.linesep
        )

        handle.write(
            "Entanglement measure: half-chain second Renyi entropy"
            + os.linesep
        )

        handle.write(
            "Work protocol: finite-temperature two-projective-measurement Jarzynski estimator"
            + os.linesep
        )


def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--config",
        type=str,
        default="config.yaml",
    )

    args = parser.parse_args()

    cfg = load_config(args.config)

    project = cfg["project"]

    plots = cfg["plots"]

    work = cfg["work_protocol"]

    output_dir = (
        project["output_dir"]
    )

    dpi = int(plots["dpi"])

    ensure_dir(output_dir)

    save_metadata(
        cfg,
        output_dir
    )

    save_reproducibility_log(
        cfg,
        output_dir
    )

    entropy_df = (
        compute_entanglement_scan(cfg)
    )

    entropy_path = (
        Path(output_dir)
        / "entropy_scan.csv"
    )

    entropy_df.to_csv(
        entropy_path,
        index=False
    )

    work_raw_df = None
    work_summary_df = None

    if bool(work["enabled"]):

        (
            work_raw_df,
            work_summary_df,
        ) = (
            jarzynski_projective_work_protocol(cfg)
        )

        raw_path = (
            Path(output_dir)
            / "work_trajectories.csv"
        )

        summary_path = (
            Path(output_dir)
            / "jarzynski_summary.csv"
        )

        work_raw_df.to_csv(
            raw_path,
            index=False
        )

        work_summary_df.to_csv(
            summary_path,
            index=False
        )

    bridge_df = compute_bridge_statistics(
        entropy_df,
        work_summary_df
    )

    bridge_path = (
        Path(output_dir)
        / "bridge_statistics.csv"
    )

    bridge_df.to_csv(
        bridge_path,
        index=False
    )

    plot_entropy_vs_h(
        entropy_df,
        output_dir,
        dpi
    )

    plot_purity_vs_h(
        entropy_df,
        output_dir,
        dpi
    )

    if (
        work_raw_df is not None
        and work_summary_df is not None
    ):

        plot_jarzynski_convergence(
            work_summary_df,
            output_dir,
            dpi
        )

        plot_work_histogram(
            work_raw_df,
            output_dir,
            dpi
        )

    print("Finished.")
    print("Outputs written to:")
    print(output_dir)


if __name__ == "__main__":
    main()
'''

