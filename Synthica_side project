def patch_code(code):
    changed = False

    # 1. insert functions
    if "def reduced_density_matrix_from_site_set_pure_state(" not in code:
        marker = "\ndef compute_entanglement_scan(cfg):"

        if marker not in code:
            raise RuntimeError("compute_entanglement_scan not found")

        code = code.replace(
            marker,
            SITE_SET_FUNCTIONS + marker,
            1
        )
        changed = True

    # 2. insert A_sites
    if "A_sites = tuple(" not in code:
        if OLD_LA_BLOCK not in code:
            raise RuntimeError("LA block not found")

        code = code.replace(OLD_LA_BLOCK, NEW_LA_BLOCK, 1)
        changed = True

    # 3. replace entropy
    if OLD_ENTROPY_BLOCK in code:
        code = code.replace(OLD_ENTROPY_BLOCK, NEW_ENTROPY_BLOCK, 1)
        changed = True

    # 4. add record column
    if '"A_sites": ",".join(str(site) for site in A_sites),' not in code:
        old_record_piece = '''                    "LA": int(LA),
                    "h": float(h),
'''

        new_record_piece = '''                    "LA": int(LA),
                    "A_sites": ",".join(str(site) for site in A_sites),
                    "h": float(h),
'''

        if old_record_piece in code:
            code = code.replace(old_record_piece, new_record_piece, 1)
            changed = True

    return code, changed


