def plot_jarzynski_convergence(
    work_summary_df,
    output_dir,
    dpi
):

    fig, ax = plt.subplots(
        figsize=(7, 5)
    )

    ax.axhline(
        float(
            work_summary_df[
                "exact_delta_F"
            ].iloc[0]
        ),
        color="black",
        linestyle="--",
        label="exact delta F",
    )

    ax.plot(
        work_summary_df[
            "n_trajectories"
        ].to_numpy(),
        work_summary_df[
            "jarzynski_delta_F"
        ].to_numpy(),
        marker="o",
        label="Jarzynski estimate",
    )

    ax.set_xscale("log")

    ax.set_xlabel(
        "number of trajectories"
    )

    ax.set_ylabel(
        "free-energy difference"
    )

    ax.set_title(
        "Jarzynski estimator convergence"
    )

