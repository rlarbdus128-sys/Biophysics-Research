def bootstrap(work, beta, n_boot=300, seed=0):
    rng = np.random.default_rng(seed)

    vals = []
    n = len(work)

    for _ in range(n_boot):
        sample = rng.choice(work, size=n, replace=True)
        vals.append(-math.log(np.mean(np.exp(-beta * sample))) / beta)

    vals = np.array(vals)
    return np.quantile(vals, [0.025, 0.5, 0.975])


