import numpy as np
import math


def exact_tpm_jarzynski_check(evals0, evecs0, evals1, evecs1, U, beta):
    boltz0 = np.exp(-beta * evals0)
    Z0 = float(np.sum(boltz0))
    Z1 = float(np.sum(np.exp(-beta * evals1)))

    p0 = boltz0 / Z0

    transition = np.abs(evecs1.conj().T @ U @ evecs0) ** 2

    factor = np.outer(
        np.exp(-beta * evals1),
        p0 * np.exp(beta * evals0)
    )

    exp_average_exact = float(np.sum(transition * factor))

    delta_F_exact = -math.log(Z1 / Z0) / beta
    delta_F_tpm = -math.log(exp_average_exact) / beta

    return {
        "exp_average_exact_tpm": exp_average_exact,
        "exp_minus_beta_delta_F": Z1 / Z0,
        "delta_F_exact": delta_F_exact,
        "delta_F_tpm": delta_F_tpm,
        "difference": delta_F_tpm - delta_F_exact
    }
def unitary_quality(U):
    dim = U.shape[0]
    identity = np.eye(dim, dtype=complex)
    deviation = U.conj().T @ U - identity
    return float(np.linalg.norm(deviation))
def bootstrap_jarzynski_delta_F(work_array, beta, n_bootstrap, seed):
    rng = np.random.default_rng(seed)
    estimates = []

    sample_size = work_array.size

    for repeat in range(n_bootstrap):
        sample = rng.choice(
            work_array,
            size=sample_size,
            replace=True
        )

        exp_average = float(np.mean(np.exp(-beta * sample)))
        estimate = -math.log(exp_average) / beta
        estimates.append(estimate)

    low, median, high = np.quantile(
        np.array(estimates),
        (0.025, 0.5, 0.975)
    )

    return {
        "jarzynski_bootstrap_low": float(low),
        "jarzynski_bootstrap_median": float(median),
        "jarzynski_bootstrap_high": float(high)
    }
def work_distribution_diagnostics(work_array, beta):
    weights = np.exp(-beta * work_array)
    normalized = weights / np.sum(weights)

    effective_sample_size = 1.0 / float(np.sum(normalized ** 2))

    mean_work = float(np.mean(work_array))
    variance_work = float(np.var(work_array))

    centered = work_array - mean_work
    third = float(np.mean(centered ** 3))

    if variance_work > 0.0:
        skewness = third / float(variance_work ** 1.5)
    else:
        skewness = float("nan")

    return {
        "mean_work": mean_work,
        "variance_work": variance_work,
        "skewness_work": skewness,
        "effective_sample_size": effective_sample_size
    }
