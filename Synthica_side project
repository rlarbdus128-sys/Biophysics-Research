def reduced_density_matrix_from_site_set_pure_state(
    psi,
    L,
    A_sites
):
    A_sites = tuple(A_sites)
    A_set = set(A_sites)

    B_sites = tuple(
        site for site in range(L)
        if site not in A_set
    )

    A_axes = tuple(
        L - 1 - site
        for site in A_sites
    )

    B_axes = tuple(
        L - 1 - site
        for site in B_sites
    )

    permutation = A_axes + B_axes

    dims = tuple(
        2 for site in range(L)
    )

    psi_tensor = np.reshape(
        psi,
        dims,
        order="C"
    )

    psi_permuted = np.transpose(
        psi_tensor,
        axes=permutation
    )

    dimA = 2 ** len(A_sites)
    dimB = 2 ** len(B_sites)

    psi_matrix = np.reshape(
        psi_permuted,
        (dimA, dimB),
        order="C"
    )

    rhoA = psi_matrix @ np.conjugate(psi_matrix).T

    return rhoA


def renyi2_entropy_site_set(
    psi,
    L,
    A_sites
):
    rhoA = reduced_density_matrix_from_site_set_pure_state(
        psi,
        L,
        A_sites
    )

    purity = float(
        np.real(
            np.trace(rhoA @ rhoA)
        )
    )

    if purity <= 0.0:
        return float("nan"), purity

    S2 = -math.log(purity)

    return float(S2), float(purity)


def von_neumann_entropy_site_set(
    psi,
    L,
    A_sites
):
    rhoA = reduced_density_matrix_from_site_set_pure_state(
        psi,
        L,
        A_sites
    )

    evals = np.linalg.eigvalsh(rhoA)

    evals = np.real(evals)
    evals = np.maximum(evals, 0.0)

    entropy = 0.0

    for value in evals:
        if value > 1.0e-14:
            entropy -= float(value) * math.log(float(value))

    return float(entropy)
