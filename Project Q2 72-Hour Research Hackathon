import os
import csv
import json
import math
import numpy as np
import matplotlib.pyplot as plt


def ensure_dir(path):
    if not os.path.exists(path):
        os.makedirs(path)


def write_default_inputs(input_dir):
    ensure_dir(input_dir)

    config = {
        "n_boundary": 3,
        "n_hidden": 3,
        "base_boundary_rate": 1.0,
        "base_hidden_rate": 1.0,
        "boundary_affinity": 1.0,
        "hidden_affinity": 2.0,
        "epsilon": 1.0e-12
    }

    config_path = os.path.join(input_dir, "config.json")

    with open(config_path, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2)

    grid_path = os.path.join(input_dir, "parameter_grid.csv")

    couplings = np.linspace(0.0, 3.0, 16)
    decoherences = np.linspace(0.0, 2.0, 11)

    with open(grid_path, "w", newline="", encoding="utf-8") as f:
        fieldnames = ("coupling", "decoherence_strength")

        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()

        for coupling in couplings:
            for decoherence_strength in decoherences:
                writer.writerow(
                    {
                        "coupling": float(coupling),
                        "decoherence_strength": float(decoherence_strength)
                    }
                )

    return config_path, grid_path


def load_config(input_dir):
    config_path = os.path.join(input_dir, "config.json")

    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)


def load_parameter_grid(input_dir):
    grid_path = os.path.join(input_dir, "parameter_grid.csv")

    rows = []

    with open(grid_path, "r", encoding="utf-8") as f:
        reader = csv.DictReader(f)

        for row in reader:
            rows.append(
                {
                    "coupling": float(row["coupling"]),
                    "decoherence_strength": float(row["decoherence_strength"])
                }
            )

    return rows


def make_states(n_boundary, n_hidden):
    return [
        (b, h)
        for b in range(n_boundary)
        for h in range(n_hidden)
    ]


def make_state_index(states):
    return {
        state: index
        for index, state in enumerate(states)
    }


def build_rates(config, coupling, decoherence_strength):
    n_boundary = int(config["n_boundary"])
    n_hidden = int(config["n_hidden"])

    base_boundary_rate = float(config["base_boundary_rate"])
    base_hidden_rate = float(config["base_hidden_rate"])

    boundary_affinity = float(config["boundary_affinity"])
    hidden_affinity = float(config["hidden_affinity"])

    states = make_states(n_boundary, n_hidden)
    state_index = make_state_index(states)

    visibility = 1.0 - math.exp(-decoherence_strength)

    rates = {}

    for source_state in states:
        b, h = source_state

        source_index = state_index[source_state]

        hidden_angle = 2.0 * math.pi * float(h) / float(n_hidden)
        boundary_angle = 2.0 * math.pi * float(b) / float(n_boundary)

        hidden_signal = math.cos(hidden_angle)
        boundary_signal = math.sin(boundary_angle)

        local_boundary_affinity = (
            boundary_affinity
            + coupling * visibility * hidden_signal
        )

        local_hidden_affinity = (
            hidden_affinity
            + 0.5 * coupling * boundary_signal
        )

        b_plus = (b + 1) % n_boundary
        b_minus = (b - 1) % n_boundary

        h_plus = (h + 1) % n_hidden
        h_minus = (h - 1) % n_hidden

        dest_boundary_plus = (b_plus, h)
        dest_boundary_minus = (b_minus, h)

        dest_hidden_plus = (b, h_plus)
        dest_hidden_minus = (b, h_minus)

        rate_boundary_plus = (
            base_boundary_rate
            * math.exp(0.5 * local_boundary_affinity)
        )

        rate_boundary_minus = (
            base_boundary_rate
            * math.exp(-0.5 * local_boundary_affinity)
        )

        rate_hidden_plus = (
            base_hidden_rate
            * math.exp(0.5 * local_hidden_affinity)
        )

        rate_hidden_minus = (
            base_hidden_rate
            * math.exp(-0.5 * local_hidden_affinity)
        )

        rates[(source_index, state_index[dest_boundary_plus])] = rate_boundary_plus
        rates[(source_index, state_index[dest_boundary_minus])] = rate_boundary_minus
        rates[(source_index, state_index[dest_hidden_plus])] = rate_hidden_plus
        rates[(source_index, state_index[dest_hidden_minus])] = rate_hidden_minus

    return states, rates


def build_generator(states, rates):
    n_states = len(states)

    q_matrix = np.zeros((n_states, n_states), dtype=float)

    for (i, j), rate in rates.items():
        q_matrix[i, j] = rate

    for i in range(n_states):
        q_matrix[i, i] = -np.sum(q_matrix[i, :])

    return q_matrix


def stationary_distribution(q_matrix):
    n_states = q_matrix.shape[0]

    a_matrix = q_matrix.T.copy()
    a_matrix[-1, :] = 1.0

    b_vector = np.zeros(n_states, dtype=float)
    b_vector[-1] = 1.0

    p = np.linalg.solve(a_matrix, b_vector)

    p = np.maximum(p, 0.0)
    p = p / np.sum(p)

    return p


def entropy_production_from_rates(
    probabilities,
    rates,
    n_states,
    epsilon
):
    entropy_production = 0.0

    for i in range(n_states):
        for j in range(i + 1, n_states):

            kij = rates.get((i, j), 0.0)
            kji = rates.get((j, i), 0.0)

            forward_flux = probabilities[i] * kij
            backward_flux = probabilities[j] * kji

            if (
                forward_flux > epsilon
                and backward_flux > epsilon
            ):
                current = forward_flux - backward_flux
                force = math.log(forward_flux / backward_flux)

                entropy_production += current * force

    return float(entropy_production)


def aggregate_boundary_rates(
    states,
    rates,
    probabilities,
    n_boundary,
    epsilon
):
    n_states = len(states)

    boundary_probabilities = np.zeros(n_boundary, dtype=float)

    for index, state in enumerate(states):
        b, _ = state
        boundary_probabilities[b] += probabilities[index]

    boundary_rates = {}

    for b in range(n_boundary):
        for bp in range(n_boundary):

            if b == bp:
                continue

            flux = 0.0

            for i in range(n_states):
                source_state = states[i]

                if source_state[0] != b:
                    continue

                for j in range(n_states):
                    dest_state = states[j]

                    if dest_state[0] == bp:
                        flux += (
                            probabilities[i]
                            * rates.get((i, j), 0.0)
                        )

            denominator = boundary_probabilities[b]

            if denominator > epsilon:
                boundary_rates[(b, bp)] = flux / denominator
            else:
                boundary_rates[(b, bp)] = 0.0

    boundary_probabilities = (
        boundary_probabilities
        / np.sum(boundary_probabilities)
    )

    return boundary_probabilities, boundary_rates


def entropy_of_distribution(probabilities, epsilon):
    total = 0.0

    for probability in probabilities:
        if probability > epsilon:
            total -= probability * math.log(probability)

    return float(total)


def information_measures(
    states,
    probabilities,
    n_boundary,
    n_hidden,
    epsilon
):
    p_boundary = np.zeros(n_boundary, dtype=float)
    p_hidden = np.zeros(n_hidden, dtype=float)

    for index, state in enumerate(states):
        b, h = state

        p_boundary[b] += probabilities[index]
        p_hidden[h] += probabilities[index]

    p_joint = probabilities.copy()

    h_boundary = entropy_of_distribution(p_boundary, epsilon)
    h_hidden = entropy_of_distribution(p_hidden, epsilon)
    h_joint = entropy_of_distribution(p_joint, epsilon)

    mutual_information = (
        h_boundary
        + h_hidden
        - h_joint
    )

    conditional_hidden_entropy = (
        h_joint
        - h_boundary
    )

    return {
        "h_boundary": h_boundary,
        "h_hidden": h_hidden,
        "h_joint": h_joint,
        "mutual_information": mutual_information,
        "conditional_hidden_entropy": conditional_hidden_entropy
    }


def run_single_model(
    config,
    coupling,
    decoherence_strength
):
    epsilon = float(config["epsilon"])

    n_boundary = int(config["n_boundary"])
    n_hidden = int(config["n_hidden"])

    states, rates = build_rates(
        config,
        coupling,
        decoherence_strength
    )

    q_matrix = build_generator(states, rates)

    stationary = stationary_distribution(q_matrix)

    full_ep = entropy_production_from_rates(
        stationary,
        rates,
        len(states),
        epsilon
    )

    boundary_probabilities, boundary_rates = aggregate_boundary_rates(
        states,
        rates,
        stationary,
        n_boundary,
        epsilon
    )

    boundary_ep = entropy_production_from_rates(
        boundary_probabilities,
        boundary_rates,
        n_boundary,
        epsilon
    )

    hidden_gap = full_ep - boundary_ep

    info = information_measures(
        states,
        stationary,
        n_boundary,
        n_hidden,
        epsilon
    )

    reflection_ratio = 0.0

    if full_ep > epsilon:
        reflection_ratio = boundary_ep / full_ep

    result = {
        "coupling": coupling,
        "decoherence_strength": decoherence_strength,
        "full_ep": full_ep,
        "boundary_ep": boundary_ep,
        "hidden_gap": hidden_gap,
        "reflection_ratio": reflection_ratio,
        "mutual_information": info["mutual_information"],
        "conditional_hidden_entropy": info["conditional_hidden_entropy"],
        "h_boundary": info["h_boundary"],
        "h_hidden": info["h_hidden"],
        "h_joint": info["h_joint"]
    }

    return result, states, rates, stationary


def write_example_rates(output_path, states, rates):
    with open(output_path, "w", newline="", encoding="utf-8") as f:

        fieldnames = (
            "source_index",
            "source_boundary",
            "source_hidden",
            "dest_index",
            "dest_boundary",
            "dest_hidden",
            "rate"
        )

        writer = csv.DictWriter(f, fieldnames=fieldnames)

        writer.writeheader()

        for key, rate in rates.items():
            source_index, dest_index = key

            source_state = states[source_index]
            dest_state = states[dest_index]

            writer.writerow(
                {
                    "source_index": source_index,
                    "source_boundary": source_state[0],
                    "source_hidden": source_state[1],
                    "dest_index": dest_index,
                    "dest_boundary": dest_state[0],
                    "dest_hidden": dest_state[1],
                    "rate": rate
                }
            )


def write_results_csv(output_dir, results):
    path = os.path.join(output_dir, "results_summary.csv")

    fieldnames = (
        "coupling",
        "decoherence_strength",
        "full_ep",
        "boundary_ep",
        "hidden_gap",
        "reflection_ratio",
        "mutual_information",
        "conditional_hidden_entropy",
        "h_boundary",
        "h_hidden",
        "h_joint"
    )

    with open(path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)

        writer.writeheader()

        for row in results:
            writer.writerow(row)

    return path


def correlation(x_values, y_values):
    n = len(x_values)

    if n < 2:
        return 0.0

    mean_x = sum(x_values) / float(n)
    mean_y = sum(y_values) / float(n)

    covariance = sum(
        (x - mean_x) * (y - mean_y)
        for x, y in zip(x_values, y_values)
    )

    variance_x = sum(
        (x - mean_x) * (x - mean_x)
        for x in x_values
    )

    variance_y = sum(
        (y - mean_y) * (y - mean_y)
        for y in y_values
    )

    denominator = math.sqrt(
        variance_x * variance_y
    )

    if denominator <= 0.0:
        return 0.0

    return covariance / denominator


def make_heatmap(
    results,
    output_dir,
    metric_name,
    file_name,
    title
):
    couplings = sorted(
        list(
            set(
                row["coupling"]
                for row in results
            )
        )
    )

    decoherences = sorted(
        list(
            set(
                row["decoherence_strength"]
                for row in results
            )
        )
    )

    z_matrix = np.zeros(
        (len(decoherences), len(couplings)),
        dtype=float
    )

    for i, decoherence_strength in enumerate(decoherences):
        for j, coupling in enumerate(couplings):

            for row in results:
                if (
                    abs(row["coupling"] - coupling) < 1.0e-12
                    and abs(
                        row["decoherence_strength"]
                        - decoherence_strength
                    ) < 1.0e-12
                ):
                    z_matrix[i, j] = row[metric_name]
                    break

    fig, ax = plt.subplots(figsize=(7.0, 5.0))

    image = ax.imshow(
        z_matrix,
        origin="lower",
        aspect="auto",
        extent=(
            min(couplings),
            max(couplings),
            min(decoherences),
            max(decoherences)
        )
    )

    ax.set_xlabel("coupling")
    ax.set_ylabel("decoherence strength")
    ax.set_title(title)

    fig.colorbar(image, ax=ax)

    fig.tight_layout()

    path = os.path.join(output_dir, file_name)

    fig.savefig(path, dpi=200)

    plt.close(fig)

    return path


def make_scatter(
    results,
    output_dir,
    x_metric,
    y_metric,
    file_name,
    title
):
    x_values = [
        row[x_metric]
        for row in results
    ]

    y_values = [
        row[y_metric]
        for row in results
    ]

    corr_value = correlation(
        x_values,
        y_values
    )

    fig, ax = plt.subplots(figsize=(6.0, 5.0))

    ax.scatter(
        x_values,
        y_values,
        s=30.0
    )

    ax.set_xlabel(x_metric)
    ax.set_ylabel(y_metric)

    ax.set_title(
        title
        + " corr="
        + str(round(corr_value, 3))
    )

    fig.tight_layout()

    path = os.path.join(output_dir, file_name)

    fig.savefig(path, dpi=200)

    plt.close(fig)

    return path, corr_value


def write_readme(
    output_dir,
    corr_hidden_gap,
    corr_mutual_information
):
    path = os.path.join(
        output_dir,
        "README_outputs.txt"
    )

    text = f"""
Output files generated by the boundary hidden toy model.

results_summary.csv:
Parameter sweep table containing full entropy production, boundary entropy production, hidden gap, reflection ratio, mutual information, and conditional hidden entropy.

heatmap_boundary_ep.png:
Heatmap of boundary observed entropy production.

heatmap_hidden_gap.png:
Heatmap of full entropy production minus boundary entropy production.

heatmap_reflection_ratio.png:
Heatmap of boundary entropy production divided by full entropy production.

scatter_boundary_vs_hidden_gap.png:
Scatter plot testing whether boundary entropy production reflects hidden entropy production.

scatter_boundary_vs_mutual_information.png:
Scatter plot testing whether boundary entropy production reflects hidden information structure.

example_rates.csv:
Example full transition rate table for one selected parameter set.

Key correlations:
boundary entropy production versus hidden gap correlation = {round(corr_hidden_gap, 6)}

boundary entropy production versus mutual information correlation = {round(corr_mutual_information, 6)}

Interpretation:
If the first correlation is positive and increases with coupling or decoherence strength, the hypothesis is supported.

If the correlation is weak or parameter dependent, the result supports the more cautious conclusion that boundary entropy production is an indirect and limited probe of hidden information structure.
"""

    with open(path, "w", encoding="utf-8") as f:
        f.write(text)

    return path


def main():
    input_dir = "toy_inputs"
    output_dir = "toy_outputs"

    ensure_dir(input_dir)
    ensure_dir(output_dir)

    write_default_inputs(input_dir)

    config = load_config(input_dir)

    parameter_grid = load_parameter_grid(input_dir)

    results = []

    selected_states = None
    selected_rates = None
    selected_stationary = None

    for row in parameter_grid:
        coupling = row["coupling"]

        decoherence_strength = row["decoherence_strength"]

        result, states, rates, stationary = run_single_model(
            config,
            coupling,
            decoherence_strength
        )

        results.append(result)

        if (
            abs(coupling - 3.0) < 1.0e-12
            and abs(decoherence_strength - 2.0) < 1.0e-12
        ):
            selected_states = states
            selected_rates = rates
            selected_stationary = stationary

    write_results_csv(output_dir, results)

    if selected_states is not None:
        example_rates_path = os.path.join(
            output_dir,
            "example_rates.csv"
        )

        write_example_rates(
            example_rates_path,
            selected_states,
            selected_rates
        )

    make_heatmap(
        results,
        output_dir,
        "boundary_ep",
        "heatmap_boundary_ep.png",
        "Boundary observed entropy production"
    )

    make_heatmap(
        results,
        output_dir,
        "hidden_gap",
        "heatmap_hidden_gap.png",
        "Hidden entropy production gap"
    )

    make_heatmap(
        results,
        output_dir,
        "reflection_ratio",
        "heatmap_reflection_ratio.png",
        "Boundary EP divided by full EP"
    )

    _, corr_hidden_gap = make_scatter(
        results,
        output_dir,
        "boundary_ep",
        "hidden_gap",
        "scatter_boundary_vs_hidden_gap.png",
        "Boundary EP versus hidden gap"
    )

    _, corr_mutual_information = make_scatter(
        results,
        output_dir,
        "boundary_ep",
        "mutual_information",
        "scatter_boundary_vs_mutual_information.png",
        "Boundary EP versus mutual information"
    )

    write_readme(
        output_dir,
        corr_hidden_gap,
        corr_mutual_information
    )

    print("Done.")
    print("Input files are in:", input_dir)
    print("Output files are in:", output_dir)

    print(
        "Correlation boundary EP versus hidden gap:",
        corr_hidden_gap
    )

    print(
        "Correlation boundary EP versus mutual information:",
        corr_mutual_information
    )


if __name__ == "__main__":
    main()

