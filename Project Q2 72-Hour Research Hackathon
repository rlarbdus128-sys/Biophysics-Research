def thermal_density_matrix(H, beta):
    evals, evecs = eigh(H)
    weights = np.exp(-beta * evals)
    weights = weights / np.sum(weights)
    rho = evecs @ np.diag(weights) @ evecs.conj().T
    return rho


def renyi2_entropy_from_density_matrix(rho, L, LA):
    dimA = 2 ** LA
    dimB = 2 ** (L - LA)

    rho_tensor = rho.reshape(dimA, dimB, dimA, dimB)

    rhoA = np.trace(
        rho_tensor,
        axis1=1,
        axis2=3
    )

    purity = float(np.real(np.trace(rhoA @ rhoA)))

    if purity <= 0.0:
        return float("nan"), purity

    entropy = -math.log(purity)

    return float(entropy), purity
