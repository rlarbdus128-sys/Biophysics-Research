python_code = r'''
import argparse
import json
import math
import os
import gc
from pathlib import Path

import yaml
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from scipy.sparse import coo_matrix
from scipy.sparse.linalg import eigsh
from scipy.linalg import eigh
from scipy.linalg import expm


def load_config(path):
    with open(path, "r", encoding="utf-8") as handle:
        return yaml.safe_load(handle)


def ensure_dir(path):
    Path(path).mkdir(parents=True, exist_ok=True)


def spin_z_value(state, site):
    bit = (state >> site) & 1
    return 1.0 if bit == 1 else -1.0


def tfim_hamiltonian_sparse(L, J, h, periodic=True):
    dim = 2 ** L

    rows = []
    cols = []
    data = []

    for state in range(dim):

        diagonal = 0.0

        for site in range(L):

            next_site = site + 1

            if next_site == L:
                if periodic:
                    next_site = 0
                else:
                    continue

            zi = spin_z_value(state, site)
            zj = spin_z_value(state, next_site)

            diagonal -= J * zi * zj

        rows.append(state)
        cols.append(state)
        data.append(diagonal)

        for site in range(L):
            flipped = state ^ (1 << site)

            rows.append(flipped)
            cols.append(state)
            data.append(-h)

    return coo_matrix(
        (data, (rows, cols)),
        shape=(dim, dim)
    ).tocsr()


def tfim_hamiltonian_dense(L, J, h, periodic=True):
    return tfim_hamiltonian_sparse(
        L, J, h, periodic
    ).toarray()


def ground_state_sparse(H):

    values, vectors = eigsh(H, k=1, which="SA")

    energy = float(values[0])

    vector = vectors[:, 0]
    vector = vector / np.linalg.norm(vector)

    return energy, vector


def renyi2_entropy_contiguous_subsystem(psi, L, LA):

    dimA = 2 ** LA
    dimB = 2 ** (L - LA)

    matrix = psi.reshape((dimA, dimB))

    rhoA = matrix @ np.conjugate(matrix).T

    purity = np.real(np.trace(rhoA @ rhoA))

    if purity <= 0:
        return float("nan"), float(purity)

    S2 = -math.log(float(purity))

    return float(S2), float(purity)


def von_neumann_entropy_contiguous_subsystem(psi, L, LA):

    dimA = 2 ** LA
    dimB = 2 ** (L - LA)

    matrix = psi.reshape((dimA, dimB))

    rhoA = matrix @ np.conjugate(matrix).T

    evals = np.linalg.eigvalsh(rhoA)
    evals = np.real(evals)
    evals = np.maximum(evals, 0.0)

    entropy = 0.0

    for value in evals:
        if value > 1.0e-14:
            entropy -= float(value) * math.log(float(value))

    return float(entropy)


def compute_entanglement_scan(cfg):

    model = cfg["model"]
    ent = cfg["entanglement"]

    L_values = model["L_values"]
    h_values = model["h_values"]

    J = float(model["J"])

    periodic = (
        model["boundary_condition"] == "periodic"
    )

    frac = float(ent["subsystem_fraction"])

    records = []

    for L in L_values:

        LA = int(round(frac * L))

        if LA < 1:
            LA = 1

        if LA >= L:
            LA = L // 2

        for h in h_values:

            print(f"Entanglement scan: L={L}, h={h}")

            H = tfim_hamiltonian_sparse(
                L, J, float(h), periodic
            )

            energy, psi0 = ground_state_sparse(H)

            S2, purity = (
                renyi2_entropy_contiguous_subsystem(
                    psi0, L, LA
                )
            )

            SvN = (
                von_neumann_entropy_contiguous_subsystem(
                    psi0, L, LA
                )
            )

            records.append(
                {
                    "L": int(L),
                    "LA": int(LA),
                    "h": float(h),
                    "ground_energy": float(energy),
                    "ground_energy_per_site":
                        float(energy) / float(L),
                    "S2_half": float(S2),
                    "purity_half": float(purity),
                    "SvN_half": float(SvN),
                }
            )

            del H
            gc.collect()

    return pd.DataFrame.from_records(records)


def thermal_free_energy_from_dense_hamiltonian(H, beta):

    evals = eigh(H, eigvals_only=True)

    emin = float(np.min(evals))

    shifted = np.exp(
        -beta * (evals - emin)
    )

    logZ = (
        -beta * emin
        + math.log(float(np.sum(shifted)))
    )

    F = -logZ / beta

    return float(F), evals


def build_unitary_linear_h_protocol(
    L,
    J,
    h_initial,
    h_final,
    total_time,
    n_steps,
    periodic
):

    dim = 2 ** L

    U = np.eye(dim, dtype=complex)

    dt = total_time / float(n_steps)

    for step in range(n_steps):

        frac = (
            (float(step) + 0.5)
            / float(n_steps)
        )

        h = (
            h_initial
            + frac * (h_final - h_initial)
        )

        H = tfim_hamiltonian_dense(
            L, J, h, periodic
        )

        U_step = expm((-1.0j * dt) * H)

        U = U_step @ U

        del H
        del U_step

        gc.collect()

    return U


def jarzynski_projective_work_protocol(cfg):

    model = cfg["model"]
    work = cfg["work_protocol"]

    seed = int(cfg["project"]["random_seed"])

    rng = np.random.default_rng(seed)

    L = int(work["L"])
    beta = float(work["beta"])

    h_initial = float(work["h_initial"])
    h_final = float(work["h_final"])

    protocol_time = float(
        work["protocol_time"]
    )

    n_time_steps = int(
        work["n_time_steps"]
    )

    n_trajectory_values = (
        work["n_trajectories"]
    )

    J = float(model["J"])

    periodic = (
        model["boundary_condition"] == "periodic"
    )

    print("Building dense Hamiltonians...")

    H0 = tfim_hamiltonian_dense(
        L, J, h_initial, periodic
    )

    H1 = tfim_hamiltonian_dense(
        L, J, h_final, periodic
    )

    F0, _ = thermal_free_energy_from_dense_hamiltonian(
        H0, beta
    )

    F1, _ = thermal_free_energy_from_dense_hamiltonian(
        H1, beta
    )

    exact_delta_F = F1 - F0

    evals0, evecs0 = eigh(H0)
    evals1, evecs1 = eigh(H1)

    shifted = np.exp(
        -beta * (
            evals0 - np.min(evals0)
        )
    )

    probs0 = shifted / np.sum(shifted)

    print("Building protocol unitary...")

    U = build_unitary_linear_h_protocol(
        L,
        J,
        h_initial,
        h_final,
        protocol_time,
        n_time_steps,
        periodic,
    )

    max_trajectories = int(
        max(n_trajectory_values)
    )

    raw_records = []
    work_values = []

    dim = 2 ** L

    print("Running trajectories...")

    for traj in range(max_trajectories):

        if traj % 1000 == 0:
            print(f"Trajectory {traj}")

        n = int(
            rng.choice(dim, p=probs0)
        )

        initial_vec = evecs0[:, n]

        evolved = U @ initial_vec

        amplitudes = (
            np.conjugate(evecs1).T @ evolved
        )

        probs_final = np.abs(amplitudes) ** 2

        probs_final = (
            probs_final
            / np.sum(probs_final)
        )

        m = int(
            rng.choice(dim, p=probs_final)
        )

        Ei = float(evals0[n])
        Ef = float(evals1[m])

        W = Ef - Ei

        work_values.append(W)

        raw_records.append(
            {
                "trajectory": int(traj),
                "initial_index": int(n),
                "final_index": int(m),
                "E_initial": float(Ei),
                "E_final": float(Ef),
                "work": float(W),
            }
        )

    work_array = np.array(
        work_values,
        dtype=float
    )

    summary_records = []

    for ntraj in n_trajectory_values:

        ntraj = int(ntraj)

        subset = work_array[:ntraj]

        exp_average = float(
            np.mean(np.exp(-beta * subset))
        )

        jarzynski_delta_F = (
            -math.log(exp_average)
            / beta
        )

        mean_work = float(np.mean(subset))

        dissipated_work = (
            mean_work - exact_delta_F
        )

        error = (
            jarzynski_delta_F
            - exact_delta_F
        )

        summary_records.append(
            {
                "L": int(L),
                "beta": float(beta),
                "h_initial": float(h_initial),
                "h_final": float(h_final),
                "protocol_time":
                    float(protocol_time),
                "n_time_steps":
                    int(n_time_steps),
                "n_trajectories":
                    int(ntraj),
                "exact_delta_F":
                    float(exact_delta_F),
                "jarzynski_delta_F":
                    float(jarzynski_delta_F),
                "jarzynski_error":
                    float(error),
                "mean_work":
                    float(mean_work),
                "dissipated_work_estimate":
                    float(dissipated_work),
            }
        )

    raw_df = pd.DataFrame.from_records(
        raw_records
    )

    summary_df = pd.DataFrame.from_records(
        summary_records
    )

    return raw_df, summary_df


def compute_bridge_statistics(
    entropy_df,
    work_summary_df
):

    records = []

    for L, sub in entropy_df.groupby("L"):

        h_values = sub["h"].to_numpy()

        S2_values = (
            sub["S2_half"].to_numpy()
        )

        energy_values = (
            sub["ground_energy_per_site"]
            .to_numpy()
        )

        if len(h_values) > 1:

            corr_S2_h = float(
                np.corrcoef(
                    h_values,
                    S2_values
                )[0, 1]
            )

            corr_S2_energy = float(
                np.corrcoef(
                    energy_values,
                    S2_values
                )[0, 1]
            )

        else:

            corr_S2_h = float("nan")
            corr_S2_energy = float("nan")

        records.append(
            {
                "L": int(L),
                "corr_S2_with_h":
                    float(corr_S2_h),
                "corr_S2_with_energy_per_site":
                    float(corr_S2_energy),
                "S2_min":
                    float(np.min(S2_values)),
                "S2_max":
                    float(np.max(S2_values)),
                "S2_range":
                    float(
                        np.max(S2_values)
                        - np.min(S2_values)
                    ),
            }
        )

    if (
        work_summary_df is not None
        and len(work_summary_df) > 0
    ):

        final_row = (
            work_summary_df
            .tail(1)
            .to_dict(orient="records")[0]
        )

        for record in records:

            record.update(
                {
                    "final_jarzynski_error":
                        float(
                            final_row[
                                "jarzynski_error"
                            ]
                        ),
                    "final_dissipated_work_estimate":
                        float(
                            final_row[
                                "dissipated_work_estimate"
                            ]
                        ),
                }
            )

    return pd.DataFrame.from_records(records)


