def tsd_ensure_dir(tsd_path):
    tsd_os.makedirs(tsd_path, exist_ok=True)


def tsd_find_input_file():

    if TSD_INPUT_PATH is not None and tsd_os.path.exists(TSD_INPUT_PATH):
        return TSD_INPUT_PATH

    tsd_search_roots = [
        ".",
        "/kaggle/input",
        "/kaggle/working",
    ]

    tsd_patterns = [
        "**/time_series_diagnostics*.csv",
        "**/time_series_diagnostics*.tsv",
        "**/time_series_diagnostics*.xlsx",
        "**/time_series_diagnostics*.xls",
        "**/time_series_diagnostics*.parquet",
        "**/time_series_diagnostics*.feather",
    ]

    tsd_candidates = []

    for tsd_root in tsd_search_roots:
        if tsd_os.path.exists(tsd_root):
            for tsd_pattern in tsd_patterns:
                tsd_candidates.extend(
                    tsd_glob.glob(
                        tsd_os.path.join(tsd_root, tsd_pattern),
                        recursive=True,
                    )
                )

    tsd_candidates = sorted(list(set(tsd_candidates)))

    if len(tsd_candidates) == 0:
        raise FileNotFoundError(
            "No time_series_diagnostics file found."
        )

    return tsd_candidates[0]


def tsd_read_table(tsd_path):

    tsd_ext = tsd_os.path.splitext(tsd_path)[1].lower()

    if tsd_ext == ".csv":
        return tsd_pd.read_csv(tsd_path)

    if tsd_ext == ".tsv":
        return tsd_pd.read_csv(tsd_path, sep="\t")

    if tsd_ext in [".xlsx", ".xls"]:
        return tsd_pd.read_excel(tsd_path)

    if tsd_ext == ".parquet":
        return tsd_pd.read_parquet(tsd_path)

    if tsd_ext == ".feather":
        return tsd_pd.read_feather(tsd_path)

    raise ValueError(f"Unsupported extension: {tsd_ext}")


def tsd_clean_columns(tsd_df):

    tsd_df = tsd_df.copy()
    tsd_df.columns = [str(c).strip() for c in tsd_df.columns]

    return tsd_df


def tsd_validate_columns(tsd_df):

    tsd_missing = [
        c for c in TSD_REQUIRED_COLUMNS
        if c not in tsd_df.columns
    ]

    if len(tsd_missing) > 0:
        raise ValueError(
            "Missing required columns:\n"
            + "\n".join(tsd_missing)
        )


def tsd_to_numeric(tsd_df):

    tsd_df = tsd_df.copy()

    for tsd_col in TSD_REQUIRED_COLUMNS:
        tsd_df[tsd_col] = tsd_pd.to_numeric(
            tsd_df[tsd_col],
            errors="coerce"
        )

    return tsd_df


def tsd_safe_auc(tsd_time, tsd_values):

    tsd_time = tsd_np.asarray(tsd_time, dtype=float)
    tsd_values = tsd_np.asarray(tsd_values, dtype=float)

    tsd_mask = (
        tsd_np.isfinite(tsd_time)
        & tsd_np.isfinite(tsd_values)
    )

    if tsd_mask.sum() < 2:
        return tsd_np.nan

    tsd_order = tsd_np.argsort(tsd_time[tsd_mask])

    return float(
        tsd_np.trapz(
            tsd_values[tsd_mask][tsd_order],
            tsd_time[tsd_mask][tsd_order],
        )
    )


def tsd_strength_from_r(tsd_r):

    if tsd_pd.isna(tsd_r):
        return "nan"

    tsd_abs = abs(float(tsd_r))

    if tsd_abs >= 0.7:
        return "strong"

    if tsd_abs >= 0.3:
        return "moderate"

    if tsd_abs >= 0.1:
        return "weak"

    return "negligible"


def tsd_safe_corr(tsd_x, tsd_y, tsd_method="pearson"):

    tsd_x = tsd_pd.Series(tsd_x).astype(float)
    tsd_y = tsd_pd.Series(tsd_y).astype(float)

    tsd_mask = tsd_x.notna() & tsd_y.notna()

    tsd_x = tsd_x[tsd_mask]
    tsd_y = tsd_y[tsd_mask]

    if len(tsd_x) < 3:
        return tsd_np.nan, tsd_np.nan, int(len(tsd_x))

    if (
        tsd_x.nunique(dropna=True) <= 1
        or tsd_y.nunique(dropna=True) <= 1
    ):
        return tsd_np.nan, tsd_np.nan, int(len(tsd_x))

    if TSD_HAS_SCIPY:

        try:

            if tsd_method == "pearson":
                tsd_r, tsd_p = tsd_stats.pearsonr(tsd_x, tsd_y)

            elif tsd_method == "spearman":
                tsd_r, tsd_p = tsd_stats.spearmanr(tsd_x, tsd_y)

            else:
                raise ValueError("Invalid correlation method")

            return float(tsd_r), float(tsd_p), int(len(tsd_x))

        except Exception:
            return tsd_np.nan, tsd_np.nan, int(len(tsd_x))

    tsd_r = tsd_x.corr(tsd_y, method=tsd_method)

    return float(tsd_r), tsd_np.nan, int(len(tsd_x))


def tsd_format_float(tsd_x):

    if tsd_pd.isna(tsd_x):
        return "nan"

    return f"{float(tsd_x):.6g}"


