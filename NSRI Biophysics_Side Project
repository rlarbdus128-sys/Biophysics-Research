# 7. Main simulation function
# -----------------------------
def run_single_simulation(J, gamma_phi,
                          gamma_down=0.08, gamma_up=0.02,
                          omega_A=1.0, omega_B=1.0):
    """
    Simulate one parameter condition and compute all time-resolved diagnostics.
    """
    H = build_hamiltonian(J, omega_A=omega_A, omega_B=omega_B)
    c_ops = build_collapse_ops(
        gamma_down=gamma_down,
        gamma_up=gamma_up,
        gamma_phi=gamma_phi
    )

    result = solve_master_equation(H, rho0, tlist, c_ops)
    states = result.states

    rho_ss = compute_steady_state(H, c_ops, fallback_state=states[-1])
    rhoA_ss = rho_ss.ptrace(0)
    rhoB_ss = rho_ss.ptrace(1)

    records = []

    D_AB = []
    D_A = []
    D_B = []

    S_AB_list = []
    S_A_list = []
    S_B_list = []
    S2_A_list = []
    Iq_list = []
    EN_log2_list = []

    for ti, rho_ab in zip(tlist, states):
        rho_A = rho_ab.ptrace(0)
        rho_B = rho_ab.ptrace(1)

        S_AB = safe_entropy_vn(rho_ab)
        S_A = safe_entropy_vn(rho_A)
        S_B = safe_entropy_vn(rho_B)
        Iq = S_A + S_B - S_AB
        S2_A = renyi2_entropy_from_qobj(rho_A)
        EN_log2 = safe_negativity_log2(rho_ab)

        D_ab = quantum_relative_entropy(rho_ab, rho_ss)
        D_a = quantum_relative_entropy(rho_A, rhoA_ss)
        D_b = quantum_relative_entropy(rho_B, rhoB_ss)

        D_AB.append(D_ab)
        D_A.append(D_a)
        D_B.append(D_b)

        S_AB_list.append(S_AB)
        S_A_list.append(S_A)
        S_B_list.append(S_B)
        S2_A_list.append(S2_A)
        Iq_list.append(Iq)
        EN_log2_list.append(EN_log2)

    D_AB = np.asarray(D_AB)
    D_A = np.asarray(D_A)
    D_B = np.asarray(D_B)

    # Entropy-production-like rates:
    # sigma(t) = - d/dt D(rho(t)||rho_ss)
    sigma_AB = -np.gradient(D_AB, tlist)
    sigma_A = -np.gradient(D_A, tlist)
    sigma_B = -np.gradient(D_B, tlist)
    delta_sigma_Q = sigma_AB - sigma_A

    # Dynamics of information/correlation diagnostics
    S_A_arr = np.asarray(S_A_list)
    S2_A_arr = np.asarray(S2_A_list)
    Iq_arr = np.asarray(Iq_list)
    EN_arr = np.asarray(EN_log2_list)

    dS_A_dt = np.gradient(S_A_arr, tlist)
    dS2_A_dt = np.gradient(S2_A_arr, tlist)
    dIq_dt = np.gradient(Iq_arr, tlist)
    dEN_dt = np.gradient(EN_arr, tlist)

    for idx, ti in enumerate(tlist):
        records.append({
            "J": J,
            "gamma_phi": gamma_phi,
            "time": ti,
            "D_AB_to_ss": D_AB[idx],
            "D_A_to_ss": D_A[idx],
            "D_B_to_ss": D_B[idx],
            "sigma_AB_rate": sigma_AB[idx],
            "sigma_A_rate": sigma_A[idx],
            "sigma_B_rate": sigma_B[idx],
            "delta_sigma_Q_rate": delta_sigma_Q[idx],
            "S_AB": S_AB_list[idx],
            "S_A": S_A_list[idx],
            "S_B": S_B_list[idx],
            "S2_A": S2_A_list[idx],
            "Iq_AB": Iq_list[idx],
            "EN_log2": EN_log2_list[idx],
            "dS_A_dt": dS_A_dt[idx],
            "dS2_A_dt": dS2_A_dt[idx],
            "dIq_dt": dIq_dt[idx],
            "dEN_dt": dEN_dt[idx]
        })

    ts_df = pd.DataFrame.from_records(records)

    # Avoid initial derivative artifact by summarizing after first few points.
    summary_df = ts_df.iloc[5:].copy()

    # Time-series correlations per run
    corr_pairs = {
        "corr_sigmaA_deltaSigmaQ": ("sigma_A_rate", "delta_sigma_Q_rate"),
        "corr_sigmaAB_deltaSigmaQ": ("sigma_AB_rate", "delta_sigma_Q_rate"),
        "corr_sigmaAB_dIq": ("sigma_AB_rate", "dIq_dt"),
        "corr_sigmaAB_dEN": ("sigma_AB_rate", "dEN_dt"),
        "corr_sigmaAB_dSA": ("sigma_AB_rate", "dS_A_dt"),
        "corr_sigmaA_dIq": ("sigma_A_rate", "dIq_dt"),
        "corr_sigmaA_dEN": ("sigma_A_rate", "dEN_dt"),
        "corr_sigmaA_dSA": ("sigma_A_rate", "dS_A_dt")
    }

    corr_results = {}
    for name, (xcol, ycol) in corr_pairs.items():
        r, p = safe_pearson(summary_df[xcol], summary_df[ycol])
        rs, ps = safe_spearman(summary_df[xcol], summary_df[ycol])
        corr_results[name + "_pearson_r"] = r
        corr_results[name + "_pearson_p"] = p
        corr_results[name + "_spearman_r"] = rs
        corr_results[name + "_spearman_p"] = ps

    run_summary = {
        "J": J,
        "gamma_phi": gamma_phi,
        "gamma_down": gamma_down,
        "gamma_up": gamma_up,

        "mean_sigma_AB_rate": float(summary_df["sigma_AB_rate"].mean()),
        "mean_sigma_A_rate": float(summary_df["sigma_A_rate"].mean()),
        "mean_delta_sigma_Q_rate": float(summary_df["delta_sigma_Q_rate"].mean()),

        "auc_sigma_AB": float(np.trapz(np.maximum(summary_df["sigma_AB_rate"], 0), summary_df["time"])),
        "auc_sigma_A": float(np.trapz(np.maximum(summary_df["sigma_A_rate"], 0), summary_df["time"])),
        "auc_delta_sigma_Q": float(np.trapz(summary_df["delta_sigma_Q_rate"], summary_df["time"])),

        "mean_S_A": float(summary_df["S_A"].mean()),
        "mean_S2_A": float(summary_df["S2_A"].mean()),
        "mean_Iq_AB": float(summary_df["Iq_AB"].mean()),
        "mean_EN_log2": float(summary_df["EN_log2"].mean()),

        "max_Iq_AB": float(summary_df["Iq_AB"].max()),
        "max_EN_log2": float(summary_df["EN_log2"].max()),

        "min_sigma_AB_rate": float(summary_df["sigma_AB_rate"].min()),
        "min_sigma_A_rate": float(summary_df["sigma_A_rate"].min()),
        "min_delta_sigma_Q_rate": float(summary_df["delta_sigma_Q_rate"].min()),

        **corr_results
    }

    return ts_df, run_summary

