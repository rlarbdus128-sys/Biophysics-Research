# 4. Numerical utilities
# -----------------------------
EPS = 1e-12

def qobj_to_dense(rho):
    """Convert QuTiP Qobj to dense complex numpy array robustly."""
    data = rho.full()
    return np.asarray(data, dtype=np.complex128)

def sanitize_density_matrix(mat):
    """
    Hermitize, normalize trace, and softly clip tiny numerical eigenvalue noise.
    Used only for numerical stability in entropy/relative-entropy calculations.
    """
    mat = np.asarray(mat, dtype=np.complex128)
    mat = 0.5 * (mat + mat.conj().T)
    tr = np.trace(mat)
    if abs(tr) > EPS:
        mat = mat / tr
    return mat

def matrix_log_psd(mat, eps=EPS):
    """
    Matrix logarithm for positive semidefinite density-like matrices.
    Eigenvalues are clipped at eps to avoid log(0) numerical singularities.
    """
    mat = sanitize_density_matrix(mat)
    vals, vecs = np.linalg.eigh(mat)
    vals_clipped = np.clip(np.real(vals), eps, None)
    log_vals = np.log(vals_clipped)
    return (vecs * log_vals) @ vecs.conj().T

def quantum_relative_entropy(rho, sigma, eps=EPS):
    """
    D(rho || sigma) = Tr[rho (log rho - log sigma)].
    This is used as a numerical diagnostic relative to the steady state.
    """
    r = sanitize_density_matrix(qobj_to_dense(rho) if hasattr(rho, "full") else rho)
    s = sanitize_density_matrix(qobj_to_dense(sigma) if hasattr(sigma, "full") else sigma)
    log_r = matrix_log_psd(r, eps=eps)
    log_s = matrix_log_psd(s, eps=eps)
    val = np.trace(r @ (log_r - log_s))
    return float(np.real_if_close(val))

def renyi2_entropy_from_qobj(rho, eps=EPS):
    """S2(rho) = -log Tr(rho^2)."""
    mat = sanitize_density_matrix(qobj_to_dense(rho))
    purity = np.real(np.trace(mat @ mat))
    purity = max(float(purity), eps)
    return -np.log(purity)

def safe_entropy_vn(rho):
    """Natural-log von Neumann entropy using QuTiP, with fallback."""
    try:
        return float(entropy_vn(rho, base=np.e))
    except Exception:
        mat = sanitize_density_matrix(qobj_to_dense(rho))
        vals = np.clip(np.real(np.linalg.eigvalsh(mat)), EPS, None)
        return float(-np.sum(vals * np.log(vals)))

def safe_negativity_log2(rho_ab):
    """Logarithmic negativity in log2 convention."""
    try:
        return float(negativity(rho_ab, subsys=0, method="tracenorm", logarithmic=True))
    except Exception:
        try:
            return float(negativity(rho_ab, subsys=0, method="eigenvalues", logarithmic=True))
        except Exception:
            return np.nan

def safe_pearson(x, y):
    """Pearson correlation with NaN protection."""
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    mask = np.isfinite(x) & np.isfinite(y)
    x = x[mask]
    y = y[mask]
    if len(x) < 3 or np.std(x) < EPS or np.std(y) < EPS:
        return np.nan, np.nan
    r, p = pearsonr(x, y)
    return float(r), float(p)

def safe_spearman(x, y):
    """Spearman correlation with NaN protection."""
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    mask = np.isfinite(x) & np.isfinite(y)
    x = x[mask]
    y = y[mask]
    if len(x) < 3 or np.std(x) < EPS or np.std(y) < EPS:
        return np.nan, np.nan
    r, p = spearmanr(x, y)
    return float(r), float(p)

# -----------------------------
# 5. Quantum system construction
# -----------------------------
I2 = qeye(2)

sx_A = tensor(sigmax(), I2)
sy_A = tensor(sigmay(), I2)
sz_A = tensor(sigmaz(), I2)
sm_A = tensor(sigmam(), I2)
sp_A = tensor(sigmap(), I2)

sx_B = tensor(I2, sigmax())
sy_B = tensor(I2, sigmay())
sz_B = tensor(I2, sigmaz())
sm_B = tensor(I2, sigmam())
sp_B = tensor(I2, sigmap())

def build_hamiltonian(J, omega_A=1.0, omega_B=1.0):
    """
    Two-qubit Hamiltonian:
    H = omega_A/2 sigma_z^A + omega_B/2 sigma_z^B
        + J/2 (sigma_x^A sigma_x^B + sigma_y^A sigma_y^B)
    """
    H0 = 0.5 * omega_A * sz_A + 0.5 * omega_B * sz_B
    Hint = 0.5 * J * (sx_A * sx_B + sy_A * sy_B)
    return H0 + Hint

def build_collapse_ops(gamma_down=0.08, gamma_up=0.02, gamma_phi=0.0):
    """
    Local relaxation/excitation plus local pure dephasing.
    """
    c_ops = []
    if gamma_down > 0:
        c_ops += [
            np.sqrt(gamma_down) * sm_A,
            np.sqrt(gamma_down) * sm_B
        ]
    if gamma_up > 0:
        c_ops += [
            np.sqrt(gamma_up) * sp_A,
            np.sqrt(gamma_up) * sp_B
        ]
    if gamma_phi > 0:
        c_ops += [
            np.sqrt(gamma_phi) * sz_A,
            np.sqrt(gamma_phi) * sz_B
        ]
    return c_ops

def solve_master_equation(H, rho0, tlist, c_ops):
    """
    Wrapper around QuTiP mesolve compatible with QuTiP 4/5 style options.
    """
    try:
        result = mesolve(
            H, rho0, tlist, c_ops=c_ops, e_ops=[],
            options={"store_states": True, "nsteps": 10000}
        )
    except TypeError:
        from qutip import Options
        result = mesolve(
            H, rho0, tlist, c_ops, [],
            options=Options(store_states=True, nsteps=10000)
        )
    return result

def compute_steady_state(H, c_ops, fallback_state=None):
    """
    Numerical steady state. If solver fails, use fallback final state.
    """
    try:
        rho_ss = steadystate(H, c_ops)
        return rho_ss
    except Exception as e:
        print("steadystate failed; using final state fallback:", repr(e))
        if fallback_state is None:
            raise
        return fallback_state

