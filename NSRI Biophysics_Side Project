import os
import zipfile
from datetime import datetime, timedelta

# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------

TSD_OUTPUT_DIR = "/kaggle/working/tsd_summary_outputs"

# Zip filename
ZIP_OUTPUT_PATH = "/kaggle/working/tsd_summary_outputs_only.zip"

# Time window (minutes)
# Files modified within this time are treated as "newly generated"
RECENT_MINUTES = 120

# ------------------------------------------------------------
# Collect recent files
# ------------------------------------------------------------

now_ts = datetime.now().timestamp()

recent_threshold = now_ts - (RECENT_MINUTES * 60)

files_to_zip = []

for root, dirs, files in os.walk(TSD_OUTPUT_DIR):

    for file in files:

        full_path = os.path.join(root, file)

        try:
            modified_time = os.path.getmtime(full_path)

            if modified_time >= recent_threshold:
                files_to_zip.append(full_path)

        except Exception as e:
            print(f"Skipping {full_path}: {e}")

# ------------------------------------------------------------
# Create ZIP
# ------------------------------------------------------------

with zipfile.ZipFile(
    ZIP_OUTPUT_PATH,
    mode="w",
    compression=zipfile.ZIP_DEFLATED
) as zipf:

    for file_path in files_to_zip:

        arcname = os.path.relpath(file_path, TSD_OUTPUT_DIR)

        zipf.write(file_path, arcname=arcname)

# ------------------------------------------------------------
# Final report
# ------------------------------------------------------------

print("=" * 80)
print("ZIP creation completed.")
print(f"ZIP file: {ZIP_OUTPUT_PATH}")
print(f"Number of files added: {len(files_to_zip)}")
print("=" * 80)

for fp in sorted(files_to_zip):
    print(fp)
