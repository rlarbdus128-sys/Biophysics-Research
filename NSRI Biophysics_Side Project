def ensure_package(pkg_name, pip_name=None):
    pip_name = pip_name or pkg_name

    # Already installed
    if importlib.util.find_spec(pkg_name) is not None:
        print(f"[OK] {pkg_name} already installed.")
        return True

    print(f"[INFO] Installing {pip_name} ...")

    install_commands = [
        [
            sys.executable,
            "-m",
            "pip",
            "install",
            pip_name,
            "--quiet",
            "--default-timeout=120",
            "--retries",
            "2"
        ]
    ]

    for cmd in install_commands:
        try:
            subprocess.run(
                cmd,
                check=True,
                timeout=300
            )

            # verify installation
            if importlib.util.find_spec(pkg_name) is not None:
                print(f"[OK] {pkg_name} installed successfully.")
                return True

        except subprocess.TimeoutExpired:
            print("[WARNING] pip install timeout exceeded.")

        except subprocess.CalledProcessError as e:
            print(f"[WARNING] pip install failed: {repr(e)}")

        except Exception as e:
            print(f"[WARNING] unexpected install error: {repr(e)}")

        time.sleep(3)

    return False


