def classify_corr(r):
    if not np.isfinite(r):
        return "undefined"
    ar = abs(r)
    if ar >= 0.7:
        return "strong"
    elif ar >= 0.4:
        return "moderate"
    elif ar >= 0.2:
        return "weak"
    else:
        return "negligible"

