    for tsd_col in TSD_VALUE_COLS:

        tsd_vals = tsd_group[tsd_col]

        tsd_out[f"mean_{tsd_col}"] = float(tsd_vals.mean())
        tsd_out[f"median_{tsd_col}"] = float(tsd_vals.median())

        tsd_out[f"std_{tsd_col}"] = (
            float(tsd_vals.std(ddof=1))
            if tsd_vals.notna().sum() > 1
            else tsd_np.nan
        )

        tsd_out[f"min_{tsd_col}"] = float(tsd_vals.min())
        tsd_out[f"max_{tsd_col}"] = float(tsd_vals.max())

        tsd_out[f"final_{tsd_col}"] = float(tsd_vals.iloc[-1])
        tsd_out[f"initial_{tsd_col}"] = float(tsd_vals.iloc[0])

        tsd_out[f"range_{tsd_col}"] = float(
            tsd_vals.max() - tsd_vals.min()
        )

        tsd_out[f"auc_{tsd_col}"] = tsd_safe_auc(
            tsd_group[TSD_TIME_COL],
            tsd_vals,
        )

    return tsd_pd.Series(tsd_out)


